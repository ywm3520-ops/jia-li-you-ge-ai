import { createServer } from 'node:http';
import { readFile } from 'node:fs/promises';
import { extname, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = resolve(fileURLToPath(new URL('.', import.meta.url)));
const types = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8' };
const MAX_BODY_BYTES = 16 * 1024;
const UPSTREAM_TIMEOUT_MS = 20_000;

function sendJson(response, status, body) {
  response.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
  response.end(JSON.stringify(body));
}

async function handleChat(request, response) {
  let raw = '';
  let tooLarge = false;
  for await (const chunk of request) {
    if (tooLarge) continue;
    raw += chunk;
    if (Buffer.byteLength(raw, 'utf8') > MAX_BODY_BYTES) { raw = ''; tooLarge = true; }
  }
  if (tooLarge) { sendJson(response, 413, { error: '请求内容过大' }); return; }

  let body;
  try { body = JSON.parse(raw); }
  catch { sendJson(response, 400, { error: '请求格式无效' }); return; }
  if (!body || typeof body !== 'object' || Array.isArray(body) || typeof body.text !== 'string' || !body.text.trim() || body.text.length > 200) {
    sendJson(response, 400, { error: '消息内容无效' });
    return;
  }

  const memory = body.context?.memory;
  const name = typeof memory?.name === 'string' ? memory.name.slice(0, 12) : '';
  const preference = typeof memory?.preference === 'string' ? memory.preference.slice(0, 24) : '';
  const apiKey = process.env.OPENROUTER_API_KEY;
  if (!apiKey) { sendJson(response, 503, { error: 'AI 服务暂不可用' }); return; }

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), UPSTREAM_TIMEOUT_MS);
  try {
    const upstream = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${apiKey}` },
      signal: controller.signal,
      body: JSON.stringify({
        model: 'openrouter/free',
        messages: [
          { role: 'system', content: `你是“家里有个AI”，请用简短、温暖、自然的中文回复。${name ? `用户希望被称为${name}。` : ''}${preference ? `用户的偏好：${preference}。` : ''}` },
          { role: 'user', content: body.text },
        ],
        stream: false,
      }),
    });
    if (!upstream.ok) { sendJson(response, 502, { error: 'AI 服务暂不可用' }); return; }
    let data;
    try { data = await upstream.json(); }
    catch { sendJson(response, 502, { error: 'AI 服务返回格式无效' }); return; }
    const reply = data?.choices?.[0]?.message?.content;
    if (typeof reply !== 'string' || !reply.trim()) { sendJson(response, 502, { error: 'AI 服务返回格式无效' }); return; }
    sendJson(response, 200, { reply: reply.trim().slice(0, 2000) });
  } catch {
    sendJson(response, 502, { error: 'AI 服务暂不可用' });
  } finally {
    clearTimeout(timeout);
  }
}

const server = createServer(async (request, response) => {
  let pathname;
  try { pathname = decodeURIComponent(new URL(request.url, 'http://localhost').pathname); }
  catch { response.writeHead(400).end('Bad request'); return; }
  if (pathname === '/api/chat') {
    if (request.method !== 'POST') { sendJson(response, 405, { error: '方法不允许' }); return; }
    await handleChat(request, response);
    return;
  }
  const relative = pathname === '/' ? 'index.html' : pathname.replace(/^\/+/, '');
  const file = resolve(root, relative);
  if (!file.startsWith(root + sep) && file !== resolve(root, 'index.html')) {
    response.writeHead(403).end('Forbidden');
    return;
  }
  try {
    const body = await readFile(file);
    response.writeHead(200, { 'Content-Type': types[extname(file)] || 'application/octet-stream' });
    response.end(body);
  } catch {
    response.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' }).end('Not found');
  }
});

const port = Number(process.env.PORT) || 4173;
server.listen(port, '0.0.0.0', () => console.log(`家里有个AI已启动：http://localhost:${port}`));
